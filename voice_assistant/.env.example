# Fuller replies: Groq free tier (OpenAI-compatible). Get a key at https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=openai/gpt-oss-20b
# Optional driving summary: https://openrouteservice.org (free key)
ORS_API_KEY=
# Optional — Hugging Face token (MMS downloads)
HF_TOKEN=
# Optional test mailbox (smtplib). Leave empty and Lentswe will not pretend it sent mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Use licensed CSIR Qfrency SAPI voices when installed (1 = on)
USE_QFRENCY=1
# Set to 0 to skip generic Windows SAPI (pyttsx3) if Edge/gTTS is enough
USE_PYTTSX3=1
# Backend / Docker
LOG_LEVEL=INFO
PORT=7000
LENTSWE_DATA_DIR=
